[package]
name = "miju-jni-udp"
version = "0.0.0"
edition = "2024"
rust-version = "1.89"
publish = false

[workspace]

[lib]
crate-type = ["cdylib"]
path = @LIB@

[dependencies]
miju-services = { path = @PRODUCT@, default-features = false, features = ["jni"] }
tokio = { version = "1.54.1", features = ["sync", "net"] }

[lints.rust]
unsafe_code = "deny"
